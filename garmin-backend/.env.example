# Copy this file to .env and fill in your credentials.
# .env is gitignored — never commit passwords.

GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_password

# Avg/max HR and duration for the calorie estimate come live from Garmin
# Connect. Weight/age/sex for the Keytel formula come from the MAUI app's
# user profile, sent as query params on /api/activities/latest — no manual
# values needed here.
