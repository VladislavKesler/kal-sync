<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:kal_sync.ViewModels"
             xmlns:conv="clr-namespace:kal_sync.Converters"
             x:Class="kal_sync.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Profil"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <!--
    ═══════════════════════════════════════════════════════════════════
      SettingsPage · user profile form
      ViewModel: SettingsViewModel
        WeightKg, BodyFatPercent, Age, SelectedSex, DeficitCap,
        CalculatedBmr, SexOptions, SaveCommand
    ═══════════════════════════════════════════════════════════════════
    -->

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Bg">#F7F8FA</Color>
            <Color x:Key="Surface">#FFFFFF</Color>
            <Color x:Key="SurfaceAlt">#EFF1F4</Color>
            <Color x:Key="Ink">#1A1F2A</Color>
            <Color x:Key="Muted">#6B7280</Color>
            <Color x:Key="Faint">#9AA1AC</Color>
            <Color x:Key="Hairline">#E2E5EA</Color>
            <Color x:Key="Accent">#A8D86A</Color>
            <Color x:Key="AccentInk">#3F6E1F</Color>

            <x:String x:Key="MonoFont">JetBrainsMono</x:String>
            <x:String x:Key="UiFont">Inter</x:String>

            <Style x:Key="Eyebrow" TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="3" />
                <Setter Property="TextTransform" Value="Uppercase" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="Stroke" Value="{StaticResource Hairline}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="14" />
                </Setter>
            </Style>

            <Style x:Key="FieldRow" TargetType="Grid">
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="ColumnDefinitions" Value="*,Auto" />
            </Style>

            <conv:DoubleToIntStringConverter x:Key="IntStr" />
            <conv:LeanBodyMassConverter      x:Key="Lbm" />
            <conv:SurplusToColorConverter    x:Key="SurplusColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource Bg}" RowDefinitions="Auto,*,Auto">

        <!-- ─────────────────────── Header ──────────────────────── -->
        <VerticalStackLayout Grid.Row="0" Padding="20,14,20,10" Spacing="2">
            <Label Style="{StaticResource Eyebrow}" Text="Profil" />
            <Label FontFamily="{StaticResource UiFont}" FontSize="19"
                   FontAttributes="Bold" TextColor="{StaticResource Ink}"
                   Text="Einstellungen" />
        </VerticalStackLayout>

        <!-- ─────────────────────── Body ────────────────────────── -->
        <ScrollView Grid.Row="1" Padding="16,8,16,20">
            <VerticalStackLayout Spacing="16">

                <!-- BMR preview card -->
                <Border Style="{StaticResource Card}" Padding="18,18,18,16">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="2">
                        <Label Style="{StaticResource Eyebrow}" Text="Katch-McArdle BMR" />
                        <HorizontalStackLayout Spacing="6">
                            <Label FontFamily="{StaticResource MonoFont}" FontSize="36"
                                   TextColor="{StaticResource Ink}"
                                   Text="{Binding CalculatedBmr, Converter={StaticResource IntStr}}" />
                            <Label FontSize="13" TextColor="{StaticResource Muted}"
                                   VerticalOptions="End" Text="kcal/Tag" Margin="0,0,0,8" />
                        </HorizontalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" Margin="0,10" />
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                <Label Style="{StaticResource Eyebrow}" Text="LBM" />
                                <Label FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       TextColor="{StaticResource Ink}"
                                       Text="{Binding ., Converter={StaticResource Lbm},
                                              StringFormat='{0:F1} kg'}" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Style="{StaticResource Eyebrow}"
                                   Text="370 + 21.6 × LBM" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Body section -->
                <Label Style="{StaticResource Eyebrow}" Text="Körper" Margin="4,0,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <!-- Weight -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Gewicht" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                   Margin="0,0,10,0"
                                   Text="{Binding WeightKg, StringFormat='{0:F1} kg'}" />
                            <Stepper Grid.Column="2" Minimum="30" Maximum="200" Increment="0.5"
                                     Value="{Binding WeightKg, Mode=TwoWay}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                        <!-- Body fat -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Körperfett" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                   Margin="0,0,10,0"
                                   Text="{Binding BodyFatPercent, StringFormat='{0:F1} %'}" />
                            <Stepper Grid.Column="2" Minimum="3" Maximum="60" Increment="0.5"
                                     Value="{Binding BodyFatPercent, Mode=TwoWay}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                        <!-- Age -->
                        <Grid Padding="16,14" ColumnDefinitions="*,Auto,Auto">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Alter" VerticalOptions="Center" />
                            <Label Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   TextColor="{StaticResource Ink}" VerticalOptions="Center"
                                   Margin="0,0,10,0"
                                   Text="{Binding AgeDouble, StringFormat='{0:F0} J.'}" />
                            <Stepper Grid.Column="2" Minimum="14" Maximum="99" Increment="1"
                                     Value="{Binding AgeDouble, Mode=TwoWay}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                        <!-- Sex -->
                        <Grid Style="{StaticResource FieldRow}">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Geschlecht" VerticalOptions="Center" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding SexOptions}"
                                    SelectedItem="{Binding SelectedSex, Mode=TwoWay}"
                                    WidthRequest="120" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Calorie target -->
                <Label Style="{StaticResource Eyebrow}" Text="Kalorienziel" Margin="4,0,0,0" />
                <Border Style="{StaticResource Card}" Padding="16,14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Kalorien-Anpassung" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   FontFamily="{StaticResource MonoFont}" FontSize="16"
                                   TextColor="{Binding CalorieAdjustment,
                                               Converter={StaticResource SurplusColor},
                                               ConverterParameter=fg}"
                                   Text="{Binding CalorieAdjustment, StringFormat='{0:+0;-0;0} kcal'}" />
                        </Grid>
                        <Slider Minimum="-500" Maximum="500"
                                Value="{Binding CalorieAdjustment, Mode=TwoWay}"
                                MinimumTrackColor="{StaticResource Accent}"
                                MaximumTrackColor="{StaticResource Hairline}"
                                ThumbColor="{StaticResource AccentInk}" />
                        <Grid ColumnDefinitions="*,*,*">
                            <Label Grid.Column="0" Style="{StaticResource Eyebrow}" Text="−500 kcal" />
                            <Label Grid.Column="1" Style="{StaticResource Eyebrow}" Text="0"
                                   HorizontalOptions="Center" />
                            <Label Grid.Column="2" Style="{StaticResource Eyebrow}" Text="+500 kcal"
                                   HorizontalOptions="End" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Widget section -->
                <Label Style="{StaticResource Eyebrow}" Text="Widget" Margin="4,0,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource FieldRow}">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Kalorien-Widget" VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding WidgetEnabled, Mode=TwoWay}"
                                    OnColor="{StaticResource AccentInk}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}"
                                 IsVisible="{Binding WidgetEnabled}" />
                        <Grid Style="{StaticResource FieldRow}"
                              IsVisible="{Binding WidgetEnabled}">
                            <Label Grid.Column="0" FontSize="12" TextColor="{StaticResource Muted}"
                                   Text="Widget zum Homescreen hinzufügen, um das Tagesziel immer im Blick zu haben."
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Notifications section -->
                <Label Style="{StaticResource Eyebrow}" Text="Benachrichtigungen" Margin="4,0,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <!-- Reminder toggle -->
                        <Grid Style="{StaticResource FieldRow}">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="KFA-Messung erinnern" VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding MeasurementReminderEnabled, Mode=TwoWay}"
                                    OnColor="{StaticResource AccentInk}" />
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource Hairline}" />
                        <!-- Interval picker -->
                        <Grid Style="{StaticResource FieldRow}">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="Intervall" VerticalOptions="Center" />
                            <Picker Grid.Column="1"
                                    ItemsSource="{Binding ReminderIntervalOptions}"
                                    SelectedItem="{Binding SelectedReminderInterval, Mode=TwoWay}"
                                    IsEnabled="{Binding MeasurementReminderEnabled}"
                                    WidthRequest="160" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Developer options -->
                <Label Style="{StaticResource Eyebrow}" Text="Entwickleroptionen" Margin="4,0,0,0" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource FieldRow}">
                            <Label Grid.Column="0" FontSize="14" TextColor="{StaticResource Ink}"
                                   Text="USB-Debugging" VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding UsbDebuggingEnabled, Mode=TwoWay}"
                                    OnColor="{StaticResource AccentInk}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Backend URL (nur im Debug-Modus) -->
                <Label Style="{StaticResource Eyebrow}" Text="Verbindung" Margin="4,0,0,0"
                       IsVisible="{Binding UsbDebuggingEnabled}" />
                <Border Style="{StaticResource Card}" Padding="16,14"
                        IsVisible="{Binding UsbDebuggingEnabled}">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="13" TextColor="{StaticResource Muted}"
                               Text="Backend-URL (z. B. http://192.168.1.100:8000)" />
                        <Entry FontFamily="{StaticResource MonoFont}"
                               FontSize="13"
                               TextColor="{StaticResource Ink}"
                               PlaceholderColor="{StaticResource Faint}"
                               Placeholder="http://192.168.1.x:8000"
                               Keyboard="Url"
                               Text="{Binding BackendUrl, Mode=TwoWay}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Save button -->
                <Button Text="Speichern"
                        Command="{Binding SaveCommand}"
                        BackgroundColor="{StaticResource Ink}"
                        TextColor="{StaticResource Bg}"
                        FontFamily="{StaticResource UiFont}"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="14"
                        HeightRequest="48" />

                <!-- Version / connection info -->
                <Label HorizontalOptions="Center"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10" TextColor="{StaticResource Faint}"
                       HorizontalTextAlignment="Center"
                       Text="{Binding BackendUrl, StringFormat='v0.1 · {0}'}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- ─────────────────────── Tab bar ─────────────────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*"
              BackgroundColor="{StaticResource Surface}" Padding="0,10,0,4">
            <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                <Image Source="icon_home.png" HeightRequest="20" WidthRequest="20" Opacity="0.5" />
                <Label Style="{StaticResource Eyebrow}" Text="Home" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHomeTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                <Image Source="icon_refresh.png" HeightRequest="20" WidthRequest="20" Opacity="0.5" />
                <Label Style="{StaticResource Eyebrow}" Text="Messungen" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMeasurementsTapped" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                <Image Source="icon_cog.png" HeightRequest="20" WidthRequest="20" />
                <Label Style="{StaticResource Eyebrow}" Text="Profil"
                       TextColor="{StaticResource Ink}" FontAttributes="Bold" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
